# Machine-specific config (start from configs/cluster.example.yaml)
configs/cluster.yaml

# Configs of additional / ablation experiments (kept locally). Only the example configs are published;
# to publish a new one, add a "!configs/<name>.yaml" line below.
configs/*.yaml
configs/*.json
!configs/benchmark.yaml
!configs/cluster.example.yaml
!configs/cluster.oar.example.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/

# AutoGluon / benchmark artifacts
AutogluonModels/
*.pkl
examples/local_run/

# Website artifacts (scripts/run_generate_website_artifacts.py)
generated_website_artifacts/

# Result files copied off the cluster (e.g. results/performance_results.csv)
results/

# Logs of local job wrappers
logs/
.data_foundry_cache/

# Cluster-specific configs, scripts and runs (kept locally, not published)
private/

# Repo-local workspace and caches of configs/cluster.yaml (benchmark runs, OpenML / Data Foundry data)
/workspace/
/workspace_*/
/cache/

# IDE and OS files
.idea/
.DS_Store

# Local session notes
HANDOFF.md
